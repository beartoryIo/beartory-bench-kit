{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["run_id", "case_id", "status", "model", "input_tokens", "output_tokens", "latency_ms"],
  "properties": {
    "run_id": {"type":"string"}, "case_id": {"type":"string"},
    "agent_id": {"type":"string"}, "condition": {"type":"string"},
    "model": {"type":"string"}, "judge_model": {"type":"string"},
    "status": {"enum":["ok","error","quota_exhausted","transport_error","incomplete"]},
    "input_tokens": {"type":"integer","minimum":0}, "output_tokens": {"type":"integer","minimum":0},
    "cache_read_tokens": {"type":"integer","minimum":0}, "cache_write_tokens": {"type":"integer","minimum":0},
    "latency_ms": {"type":"integer","minimum":0}, "tool_calls": {"type":"integer","minimum":0},
    "estimated_cost_usd": {"type":"number","minimum":0}, "retries": {"type":"integer","minimum":0}
  }
}
